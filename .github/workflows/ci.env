# Shared CI docker-compose env — dummy, non-production values only.
# Consumed by test.yml (smoke) and nightly.yml, which `cp` this to .env before
# `docker compose up`. nightly appends RATE_LIMIT_* overrides so its long
# E2E/ZAP runs from one IP aren't throttled.
#
# Lives under .github/workflows/ (not a workflow — GitHub ignores non-YAML here)
# so it's covered by the detect-secrets exclusion for that path; these are CI
# dummy values, never real secrets.
APP_ENV=ci
DEBUG=false
# e2e provisions an admin via /auth/register (the Playwright container can't
# reach Postgres to promote one). Safe here: config.py refuses to start with
# this True when APP_ENV=production, so it can never ship as a live priv-esc path.
ALLOW_ADMIN_SELF_REGISTRATION=true
POSTGRES_PASSWORD=testpassword
DATABASE_URL=postgresql+asyncpg://shopflow:testpassword@postgres:5432/shopflow
REDIS_PASSWORD=testredis
REDIS_URL=redis://:testredis@redis:6379/0
JWT_SECRET_KEY=ci-test-secret-key-not-for-production-use-64-chars-minimum-xxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=["http://localhost:3000"]
GRAFANA_PASSWORD=admin
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=shopflow-test
ANTHROPIC_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
